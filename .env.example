# Turso 資料庫設定（此分支使用 Turso 雲端資料庫，取代本機 SQLite 檔案）
# 到 https://turso.tech 建立資料庫後，在資料庫頁面取得這兩個值
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend API 設定（用來寄送報名通知信，走 HTTPS API，不受雲端平台擋 SMTP 埠影響）
# 到 https://resend.com 註冊帳號後，在後台建立一組 API Key 填在這裡
RESEND_API_KEY=

# Cloudinary 設定（用來存放教學作品相簿的圖片，不能存在 Render 本機磁碟）
# 到 https://cloudinary.com 註冊帳號後，在 Dashboard 首頁可以看到這三個值
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 後台管理密碼（進入 /admin.html 與後台 API 需要的密碼）
ADMIN_PASSWORD=

# 用來簽章登入 cookie 的密鑰，可以隨便填一串亂數字串；不填的話會退回用 ADMIN_PASSWORD
SESSION_SECRET=

# 複製這個檔案為 .env，並填入上面的值
